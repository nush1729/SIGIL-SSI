# Deployer wallet private key (use a fresh/test-only wallet, never your main wallet)
PRIVATE_KEY=

# Sepolia RPC endpoint (Alchemy/Infura free tier, or leave blank to use the public default)
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Etherscan API key, for contract source verification
ETHERSCAN_API_KEY=

# Minimum ETH an issuer must stake before being marked trusted (deploy-all.js).
# Optional — defaults to 0.001 ETH if unset.
TRUST_REGISTRY_MINIMUM_STAKE=0.001

# --- Used by scripts/deployIdentity.js, scripts/issue.js, scripts/read.js,
#     scripts/e2e-sepolia-test.js, scripts/e2e-guardian-recovery-test.js,
#     scripts/e2e-zk-schema-test.js ---
# (deploy:sepolia needs none of these; it deploys the whole stack from
# scratch and prints every address)

# Addresses of the already-deployed contracts (output of deploy-all.js)
SSI_REGISTRY_ADDRESS=
TRUST_REGISTRY_ADDRESS=
INTERACTION_HUB_ADDRESS=
SCHEMA_REGISTRY_ADDRESS=
AGE_VERIFICATION_ADDRESS=

# scripts/deployIdentity.js
IDENTITY_OWNER_ADDRESS=
IDENTITY_GUARDIAN_ADDRESSES=
IDENTITY_RECOVERY_THRESHOLD=

# scripts/issue.js, scripts/read.js
RECIPIENT_ADDRESS=
