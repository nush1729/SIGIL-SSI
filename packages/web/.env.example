# ─────────────────────────────────────────────────────────────────────────────
# Sigil — Frontend (.env.local)
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployed contract addresses (output of `pnpm contracts:compile && pnpm
#    --filter sigil-contracts run deploy:sepolia`) ────────────────────────────
# Paste the addresses printed by deploy-all.js after a successful deployment.
NEXT_PUBLIC_SSI_ADDRESS=
NEXT_PUBLIC_TRUSTREGISTRY_ADDRESS=
NEXT_PUBLIC_INTERACTIONHUB_ADDRESS=
NEXT_PUBLIC_SCHEMA_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGE_VERIFICATION_ADDRESS=

# ── WalletConnect Cloud ─────────────────────────────────────────────────────
# Get a free project ID at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Pinata (IPFS) ──────────────────────────────────────────────────────────
# Create a free account at https://app.pinata.cloud/ and generate API keys.
# You can authenticate with *either* a JWT *or* an API-key + secret pair.
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# ── Google Gemini (document OCR / extraction) ───────────────────────────────
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Etherscan (on-chain analytics) ──────────────────────────────────────────
# Get a free API key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
